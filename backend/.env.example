PORT=3000
APP_TIMEZONE=Asia/Jakarta
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=billing_app
DB_PASSWORD=change_this_password
DB_NAME=billing_rwnet
# Run scheduled billing/isolation checks every minute
SCHEDULER_ENABLED=true

# Generate once with: openssl rand -hex 32
ROUTER_CREDENTIAL_KEY=replace_with_64_hex_characters_from_openssl

# Safe sequential mass isolation defaults
ISOLATION_BATCH_SIZE=5
ISOLATION_ITEM_DELAY_MS=2000
ISOLATION_BATCH_DELAY_MS=5000

# Android APK update metadata (increase APP_VERSION_CODE for every APK release)
APP_VERSION=1.0.0
APP_VERSION_CODE=1
APP_APK_URL=https://billing.example.com/downloads/billing-latest.apk
APP_FORCE_UPDATE=false
APP_RELEASE_NOTES=Pembaruan aplikasi tersedia.
